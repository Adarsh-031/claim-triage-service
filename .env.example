# --- LLM (never commit real values) ---
LLM_PROVIDER=stub                # stub | openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_MODEL_PRIMARY=               # a free model that supports tool calling
LLM_MODEL_FALLBACK=              # second free model
LLM_TIMEOUT_S=20
TOOL_TIMEOUT_S=5

# --- Agent limits ---
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=15
AGENT_RUN_TIMEOUT_S=60

# --- Resilience ---
RETRY_MAX=3
BREAKER_FAIL_THRESHOLD=5
BREAKER_WINDOW_S=30
BREAKER_RESET_S=30

# --- Corpus ---
AIRLINE_CODE=                    # e.g. 6E (IndiGo) once confirmed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Infra ---
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://triage:triage@postgres:5432/triage
QDRANT_URL=http://qdrant:6333
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
RATE_LIMIT_PER_MIN=30
